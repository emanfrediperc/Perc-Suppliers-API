# Server
PORT=3100
CORS_ORIGIN=http://localhost:4200
# Entorno: 'development' habilita Swagger. En prod dejarlo en 'production' o sin setear.
NODE_ENV=development
# Swagger UI (/api/docs): apagado por defecto (fail-closed). Poner en 1 para exponerlo
# de forma explicita. NO dejar en 1 en produccion: divulga el mapa completo de la API.
SWAGGER_ENABLED=0

# MongoDB
MONGODB_URI=mongodb://localhost:27017/perc-suppliers

# JWT
JWT_SECRET=replace-with-32-plus-char-random-string-please
JWT_EXPIRES_IN=24h

# AWS S3 (Storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=perc-suppliers-facturas
AWS_S3_ENDPOINT=

# Google Gemini (OCR)
GEMINI_API_KEY=your-gemini-api-key

# Email (optional). Two modes — Resend HTTP API (preferred, works where
# SMTP is blocked like Railway) or SMTP via nodemailer. If RESEND_API_KEY
# is set, SMTP is ignored.

# Resend HTTP API (recommended)
RESEND_API_KEY=

# SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

EMAIL_FROM=noreply@perc-suppliers.com

# Finnegans ERP (optional — if empty, uses mock data)
FINNEGANS_BASE_URL=https://api.teamplace.finneg.com
FINNEGANS_AUTH_URL=https://api.teamplace.finneg.com/oauth/token
FINNEGANS_CLIENT_ID=your-finnegans-client-id
FINNEGANS_CLIENT_SECRET=your-finnegans-client-secret

# AFIP — WSAA + ws_sr_padron_a5 (constancia de inscripción)
# Si cualquiera de los 3 falta, las consultas devuelven null sin romper la API.
AFIP_ENV=homologacion
AFIP_CERT_PATH=./certs/afip.crt
AFIP_KEY_PATH=./certs/afip.key
AFIP_CUIT_REPRESENTADO=

# Apócrifos AFIP — bloqueante en creación de factura.
# Requiere cuenta en 2captcha.com (API key). Si TWOCAPTCHA_API_KEY está vacío,
# la verificación se saltea (no bloquea). Cache de resultados en Mongo.
TWOCAPTCHA_API_KEY=
APOCRIFOS_CACHE_DAYS=30
# Cron diario a las 3am: invalida cache y re-consulta apócrifos para
# proveedores con facturas creadas en los últimos N días.
APOCRIFOS_RECHECK_WINDOW_DAYS=90

# RFC 3161 Time Stamping Authority — sello de tiempo en transiciones de SolicitudPago
# Si TSA_ENABLED=false o el TSA no responde dentro del timeout, el historial sigue
# protegido por hash encadenado pero sin token TSA. La transición no se bloquea.
TSA_ENABLED=true
TSA_URL=https://freetsa.org/tsr
TSA_TIMEOUT_MS=3000

# Recordatorio diario a contabilidad: si una solicitud lleva > N horas en pendiente,
# el cron de las 9am reenvía email con la lista.
SOLICITUD_PAGO_REMINDER_HOURS=24

# Magic link para decisiones de aprobación sin login (default: desactivado)
ENABLE_MAGIC_LINK=false
MAGIC_LINK_BASE_URL=http://localhost:4200/aprobar
MAGIC_LINK_TTL_HOURS=48

# Proxies confiables para resolver la IP real del cliente (Express trust proxy).
# Detrás de AWS CloudFront + ALB el cliente está a 2 hops -> poné 2 en producción.
# En dev local sin proxy usá 0 (req.ip = socket, no spoofeable vía X-Forwarded-For).
TRUST_PROXY_HOPS=0

# Step-up / segundo factor para aprobaciones de monto alto (default: desactivado).
# Si STEP_UP_ENABLED=true, las aprobaciones con monto >= STEP_UP_MONTO_UMBRAL exigen
# un segundo factor antes de decidir. Factor: 'password' (MVP) o 'totp'.
STEP_UP_ENABLED=false
STEP_UP_MONTO_UMBRAL=1000000
STEP_UP_FACTOR_DEFAULT=password

# Clave AES-256-GCM para cifrar el secreto TOTP en reposo: hex de 64 chars (32 bytes).
# Requerida sólo si se usa TOTP. Generá una con: openssl rand -hex 32
TOTP_ENC_KEY=

# 2FA obligatorio en el login para TODOS los usuarios (TOTP). Si un usuario no lo
# tiene configurado, el login lo fuerza a enrolarse (QR). Requiere TOTP_ENC_KEY.
# Default false para no romper dev local (login normal email+password).
LOGIN_2FA_ENABLED=false

# Clave AES-256-GCM para cifrar el CBU (datos bancarios) en reposo: hex de 64 chars (32 bytes).
# Si está vacía en dev/test, el CBU se guarda en texto plano (coexistencia para migración
# gradual) y el arranque emite un WARNING visible. En producción (NODE_ENV=production) es
# OBLIGATORIA: sin ella la API NO arranca (fail-closed, para no persistir CBU en plaintext).
# Un valor con formato inválido falla al arrancar, no en runtime.
# Generá una con: openssl rand -hex 32. Para migrar CBUs existentes: npm run migrate:cifrar-cbu
CBU_ENC_KEY=

# Clave secreta para el HMAC-SHA256 de la cadena del audit log. Vive FUERA de la DB,
# así un insider con acceso de escritura a `audit_logs` no puede recomputar la cadena
# tras editar registros (no tiene el secreto). Si está vacía, la cadena cae a SHA-256
# plano (best-effort, NO resiste insiders) — sólo dev local. Generá una con: openssl rand -hex 32
AUDIT_HMAC_KEY=

# Seed (optional — random if unset, required in production with ALLOW_SEED=1)
SEED_PASSWORD=
ALLOW_SEED=

# MongoDB credentials (required when using docker-compose with --auth)
MONGO_ROOT_USER=
MONGO_ROOT_PASS=
